---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import placeholderShot from '../assets/screenshot-placeholder-b9.png';

/**
 * Project screenshots — real images when a project supplies them, labelled
 * placeholders when it doesn't.
 *
 * Every real image lands under src/assets/projects/<anything>/ and is
 * resolved here through import.meta.glob rather than a hand-written import —
 * so adding one is "drop the file, list its path in the project's JSON," not
 * a code change. A path listed in the JSON that doesn't resolve to a real
 * file throws at build time with the exact path it looked for, rather than
 * silently rendering a broken image.
 *
 * This component used to also render a demo-video facade. Per Vasilis: pics
 * only, no video anywhere on the site. Removed rather than left dormant —
 * see the Phase 14-era commit for the full video system if it's ever wanted
 * back; nothing here references it any more.
 */
interface Props {
  projectTitle: string;
  /** Real screenshot paths, relative to src/assets/projects/. */
  screenshots?: string[];
  /** Placeholder box count, used only when `screenshots` is empty. */
  screenshotCount?: number;
}

const { projectTitle, screenshots = [], screenshotCount = 0 } = Astro.props;

const projectAssets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

function resolveAsset(relativePath: string): ImageMetadata {
  const key = `/src/assets/projects/${relativePath}`;
  const mod = projectAssets[key];
  if (!mod) {
    const available = Object.keys(projectAssets).join(', ') || '(none found)';
    throw new Error(
      `MediaStrip: "${relativePath}" is listed for ${projectTitle} but no file exists at ` +
        `src/assets/projects/${relativePath}. Available under src/assets/projects/: ${available}`,
    );
  }
  return mod.default;
}

const shots =
  screenshots.length > 0
    ? screenshots.map((path, i) => ({ n: i + 1, src: resolveAsset(path), real: true }))
    : Array.from({ length: screenshotCount }, (_, i) => ({
        n: i + 1,
        src: placeholderShot,
        real: false,
      }));
---

{shots.length > 0 && (
  <div
    class="strip-wrap"
    role="region"
    tabindex="0"
    aria-label={`${projectTitle} screenshots, scrollable`}
  >
    <ul class="strip" role="list">
      {shots.map((shot) => (
        <li>
          <figure>
            <Picture
              src={shot.src}
              alt={
                shot.real
                  ? `${projectTitle} screenshot ${shot.n}`
                  : `Placeholder graphic standing in for ${projectTitle} screenshot ${shot.n} — blocker B9.`
              }
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[320, 480, 640]}
              sizes="(min-width: 64rem) 420px, 80vw"
              loading="lazy"
              decoding="async"
            />
            {!shot.real && (
              <figcaption>PLACEHOLDER — B9 · screenshot {shot.n}</figcaption>
            )}
          </figure>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  /* Scroll-snap strip, never an auto-advancing carousel. The scroll
     container is the wrapper, not the list, so that the thing taking
     keyboard focus is a labelled region rather than a bare <ul>. */
  .strip-wrap {
    margin-top: var(--sp-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;

    /* MOBILE_SPEC §10 — stops the swipe from triggering the browser's
       back gesture when the strip reaches its end. */
    overscroll-behavior-x: contain;

    /* The visible affordance: the second item is deliberately clipped at the
       right edge so it is obvious there is more to scroll to. */
    scrollbar-width: thin;
  }

  .strip {
    display: flex;
    gap: var(--sp-4);
    margin: 0;
    padding: 0 0 var(--sp-2);
  }

  .strip > li {
    flex: 0 0 80%;
    scroll-snap-align: start;
  }

  .strip :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }

  .strip figure {
    margin: 0;
  }

  .strip figcaption {
    margin-top: var(--sp-2);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-mono);
  }

  @media (min-width: 48rem) {
    .strip > li {
      flex-basis: 26.25rem; /* 420px */
    }
  }
</style>
