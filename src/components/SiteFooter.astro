---
import { navItems, site } from '../lib/site';

/**
 * The year is resolved at build time, not in the browser. A static site has no
 * runtime, and shipping a script to render four digits would be absurd — but
 * it does mean the footer year is the year of the last deploy.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <p class="footer-name">{site.name}</p>
      <p class="footer-line">Full-stack developer — Java, Spring Boot, React.</p>
    </div>

    {/* With JavaScript off and the sheet inert, these are the links that must
        reach every section. They are plain anchors, so they always do. */}
    <nav class="footer-nav" aria-label="Sections">
      <ul role="list">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    {/* The four profile links used to be repeated here. They now sit in the
        Contact section immediately above, and printing the same email, the
        same two profiles and the same CV path twice within one screen is
        exactly the kind of thing the anti-sloppiness checklist is about. The
        footer keeps navigation and provenance; Contact owns the addresses. */}

    <p class="footer-meta">
      <span>© {year}</span>
      <span aria-hidden="true">·</span>
      <span>Built with Astro. No trackers, no cookies, no third-party requests.</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--paper-3);
    border-top: var(--rule) solid var(--line);
    margin-top: var(--section-y);
  }

  .footer-inner {
    display: grid;
    gap: var(--sp-6);
    padding-top: var(--sp-6);

    /* MOBILE_SPEC §6 — clear the iOS home indicator. */
    padding-bottom: max(var(--sp-7), env(safe-area-inset-bottom));
  }

  .footer-name {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: var(--lh-head);
  }

  .footer-line {
    color: var(--ink-3);
    font-size: var(--fs-small);
    line-height: var(--lh-ui);
    margin-top: var(--sp-1);
  }

  .footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin: 0;
    padding: 0;
  }

  /* Every footer link is a real 44px target. The reference site fails this on
     31 of its 40 links; the whole point of the audit was to not repeat it. */
  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
  }

  .footer-nav a {
    justify-content: center;
    padding-inline: var(--sp-2);
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    line-height: var(--lh-ui);
    max-width: var(--measure);
  }

  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: var(--sp-8);
    }

    .footer-meta {
      grid-column: 1 / -1;
    }
  }
</style>
