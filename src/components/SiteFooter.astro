---
import { navItems, profileLinks, site } from '../lib/site';

/**
 * The year is resolved at build time, not in the browser. A static site has no
 * runtime, and shipping a script to render four digits would be absurd — but
 * it does mean the footer year is the year of the last deploy.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-identity">
      <p class="footer-name">{site.name}</p>
      <p class="footer-line">Full-stack developer — Java, Spring Boot, React.</p>
    </div>

    {/* With JavaScript off and the sheet inert, these are the links that must
        reach every section. They are plain anchors, so they always do. */}
    <nav class="footer-nav" aria-label="Sections">
      <ul role="list">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="footer-links" role="list">
      {profileLinks.map((link) => (
        <li>
          <a href={link.href} aria-label={link.label} class="wrap-anywhere">
            {link.text}
          </a>
        </li>
      ))}
    </ul>

    <p class="footer-meta">
      <span>© {year}</span>
      <span aria-hidden="true">·</span>
      <span>Built with Astro. No trackers, no cookies, no third-party requests.</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--paper-3);
    border-top: var(--rule) solid var(--line);
    margin-top: var(--section-y);
  }

  .footer-inner {
    display: grid;
    gap: var(--sp-6);
    padding-top: var(--sp-7);

    /* MOBILE_SPEC §6 — clear the iOS home indicator. */
    padding-bottom: max(var(--sp-7), env(safe-area-inset-bottom));
  }

  .footer-name {
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--fs-h3);
    line-height: var(--lh-head);
  }

  .footer-line {
    color: var(--ink-3);
    font-size: var(--fs-small);
    line-height: var(--lh-ui);
    margin-top: var(--sp-1);
  }

  .footer-nav ul,
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    margin: 0;
    padding: 0;
  }

  .footer-links {
    display: grid;
    gap: var(--sp-1);
  }

  /* Every footer link is a real 44px target. The reference site fails this on
     31 of its 40 links; the whole point of the audit was to not repeat it. */
  .footer-nav a,
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    min-width: var(--tap-min);
  }

  .footer-nav a {
    justify-content: center;
    padding-inline: var(--sp-2);
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-decoration: none;
  }

  .footer-links a {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    line-height: var(--lh-ui);
    max-width: var(--measure);
  }

  @media (min-width: 48rem) {
    .footer-inner {
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: var(--sp-8);
    }

    .footer-links {
      grid-column: 2;
      grid-row: 1 / span 2;
      justify-items: end;
      text-align: right;
    }

    .footer-meta {
      grid-column: 1 / -1;
    }
  }
</style>
