---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

/**
 * The page.
 *
 * Sections land one phase at a time. What is left below are structural stubs,
 * not content — they exist so the
 * header and footer anchors resolve, so scroll-margin-top can be verified
 * against the sticky header, and so the page-height measurement has something
 * to measure. Each one is replaced by its own phase:
 *
 *   Hero      Phase 3        Skills     Phase 6
 *   Awards    Phase 4        About      Phase 7
 *   Work      Phase 5        Contact    Phase 8
 *
 * Every stub is visibly labelled. None can survive to production unnoticed,
 * and the Phase 14 build guard is a second line of defence.
 */
const stubs = [
  { id: 'awards', title: 'Awards', phase: 4, tint: 'paper-2' },
  { id: 'work', title: 'Work', phase: 5, tint: 'paper' },
  { id: 'skills', title: 'Skills', phase: 6, tint: 'paper-2' },
  { id: 'about', title: 'About', phase: 7, tint: 'paper' },
  { id: 'education', title: 'Education', phase: 7, tint: 'paper-2' },
  { id: 'contact', title: 'Contact', phase: 8, tint: 'paper-3' },
] as const;
---

<BaseLayout>
  <Hero />

  {stubs.map((stub) => (
    <section id={stub.id} aria-labelledby={`${stub.id}-heading`} data-tint={stub.tint}>
      <div class="container section-inner">
        <h2 id={`${stub.id}-heading`}>{stub.title}</h2>
        <p class="stub-note">Structural stub — built in Phase {stub.phase}.</p>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  /* DESIGN_SYSTEM §1.2 — the tint ladder. Alternating backgrounds give the
     scroll rhythm without drawing a single divider line. Full-bleed, which is
     why .container rather than body carries the gutter. */
  section[data-tint='paper'] {
    background-color: var(--paper);
  }

  section[data-tint='paper-2'] {
    background-color: var(--paper-2);
  }

  section[data-tint='paper-3'] {
    background-color: var(--paper-3);
  }

  .section-inner {
    padding-block: var(--section-y);
  }

  .stub-note {
    margin-top: var(--sp-3);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--tracking-mono);
  }
</style>
