---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Awards from '../components/Awards.astro';
import Work from '../components/Work.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';

/**
 * The page. One long scroll, in the order a stranger should meet it:
 *
 *   Hero       who, and the one result that matters
 *   Awards     the proof, with the Shenzhen win treated as a headline
 *   Work       three case studies - the core asset
 *   Skills     what he works with
 *   About      the voice
 *   Education  the credentials
 *   Contact    the fastest way to reach him
 *
 * Every section is its own component and owns its own tint, so the order here
 * is the only thing this file decides. The structural stubs that stood in for
 * these through Phases 2-7 are gone; nothing placeholder-shaped remains in the
 * page skeleton.
 */
---

<BaseLayout>
  <Hero />
  <Awards />
  <Work />
  <Skills />
  <About />
  <Education />
  <Contact />
</BaseLayout>
