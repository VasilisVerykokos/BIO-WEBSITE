# syntax=docker/dockerfile:1.7

# Development image: the Astro dev server with hot reload.
# Source is bind-mounted by compose, so this image holds only the dependencies.
#
#   docker compose --profile dev up

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

EXPOSE 4321

# --host binds 0.0.0.0. Without it the dev server listens on localhost inside the
# container only, and the published port answers nothing.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
