{
  "name": "bio-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro",
    "a11y": "axe http://localhost:4321 --exit",
    "a11y:ci": "npm run build && astro preview && npm run a11y && astro preview stop",
    "fonts": "node scripts/subset-fonts.mjs",
    "prebuild": "npm run fonts",
    "lhci": "lhci autorun",
    "og": "node scripts/generate-og.mjs",
    "postbuild": "node scripts/verify-build.mjs",
    "verify:strict": "node scripts/verify-build.mjs --strict"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/cli": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "subset-font": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
