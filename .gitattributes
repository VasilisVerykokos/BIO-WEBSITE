# Normalise line endings. core.autocrlf is true on this machine, which rewrites LF to
# CRLF in the working tree. Without this file those CRLFs reach the Linux build
# container and break shebangs in scripts and any file nginx serves byte-for-byte.
* text=auto eol=lf

# Binary — never touch these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.avif   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.mp4    binary
*.webm   binary

# Generated — keep diffs quiet in reviews.
package-lock.json  -diff linguist-generated
